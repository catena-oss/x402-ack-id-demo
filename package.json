{
  "name": "x402-ack-id-demo",
  "version": "0.1.0",
  "description": "Reference demo: ACK-ID (did:web + JWT) identity verification gating an x402 USDC payment on Base Sepolia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catena-oss/x402-ack-id-demo.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "seller": "tsx src/seller/main.ts",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:valid": "tsx scripts/demo.ts valid",
    "demo:missing-identity": "tsx scripts/demo.ts missing-identity",
    "demo:mismatched-identity": "tsx scripts/demo.ts mismatched-identity",
    "demo:expired-identity": "tsx scripts/demo.ts expired-identity",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@agentcommercekit/did": "0.11.0",
    "@agentcommercekit/jwt": "0.11.0",
    "@agentcommercekit/keys": "0.11.0",
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "@x402/express": "2.21.0",
    "@x402/fetch": "2.21.0",
    "express": "^5.1.0",
    "viem": "^2.55.16",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.0"
  }
}
